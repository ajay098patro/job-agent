# =============================================================================
# Git Ignore Configuration - Job Search & Application Automation Engine
# =============================================================================

# --- Playwright & Browser Automation Artifacts ---
_pw-output/
.playwright-mcp/
.playwright/
test-results/
playwright-report/
blob-report/
playwright-trace/
playwright/.cache/
PlaywrightProfile/
storage-state.json
*.cookies

# --- Node.js & Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Scratch, Backups & Temporary Files ---
scratch/
tmp/
temp/
*.tmp
*.bak
*.bak[0-9]*
*.backup
*.orig
*.swp
*.swo
*.kate-swp
*~
nohup.out
*_live_test.txt
mission_*.txt
test_*.txt

# --- Local SQLite Databases & Session State ---
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.db-journal
session.json
**/data/session.json
!**/data/.gitkeep

# --- LaTeX & Resume Compilation Intermediate Files ---
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.pdfsync
*.toc
*.lot
*.lof
*.out
*.log
*.dvi
*.xdv
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.idx
*.ind
*.ilg
*.glo
*.gls
*.glg
**/cv/out/*
!**/cv/out/.gitkeep
**/cv/variants/*.pdf
!**/cv/variants/.gitkeep
**/cv/variants/temp_*/
**/cv/out/temp_*/

# --- Environment Variables, Secrets & Local Overrides ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
credentials.json
token.json
profile.local.json
mcp_config.json
mcp_config.local.json
.mcp.json
.codex/

# --- Operating System & IDE Files ---
# macOS
.DS_Store
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
*:Zone.Identifier
# Linux / KDE / Freedesktop / NFS
.directory
.Trash-*
.nfs*
